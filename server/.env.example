# Required: a key for the LLM that extracts and consolidates memories.
# This example uses OpenRouter; text you save is sent to that provider.
# Model comparisons and alternatives: ../docs/models.md.
LLM_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=minimax/minimax-m3.1-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_REASONING_EFFORT=high
# OpenRouter routes only to endpoints that honour every sent parameter (the strict
# JSON schema among them); otherwise it may pick one that ignores the schema.
LLM_EXTRA_BODY='{"provider":{"require_parameters":true}}'

# Fully local alternative: Ollama. Comment out the block above, including
# LLM_EXTRA_BODY, and uncomment this one. The model must follow JSON schemas
# reliably; check the Hindsight docs for the provider settings of your model.
# Docker Desktop and OrbStack reach the host's Ollama as is. On Linux, Ollama listens
# on 127.0.0.1 by default, which containers cannot reach: set OLLAMA_HOST=0.0.0.0
# for the Ollama service and keep port 11434 closed to other machines with a firewall,
# or point LLM_BASE_URL at an Ollama elsewhere on your network.
# LLM_API_KEY=ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=<your model>
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# Context window for the model. Set it explicitly; tested with 65536.
# OLLAMA_NUM_CTX=65536
# Optional, for Gemma 4 26B (gemma4:26b-a4b-it-qat): Hindsight turns Ollama thinking
# off and uses low temperatures; this restores the tested settings. See ../docs/models.md.
# LLM_EXTRA_BODY='{"think":true,"options":{"temperature":1.0}}'

# Language of extracted memories, e.g. English, Russian.
MEMORY_LANGUAGE=English

# Local model that reranks recall results, only in banks with reranking turned on.
# bank.json creates the skill's bank with reranking off, so it is not used by default.
# The default, hindsight-ai/hs-rerank-1, does not list Russian. The model below is
# recommended for short Russian memories on CPU; input limit: 512 tokens.
# About 0.5 GB. After changing this value, apply with docker compose up -d,
# then enable reranking in the bank settings. See ../docs/models.md.
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Host ports; the API and UI bind to loopback only.
API_PORT=8888
UI_PORT=9999
